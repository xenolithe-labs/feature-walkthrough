{
  "name": "feature-walkthrough",
  "version": "0.1.0",
  "description": "A configurable UI that shows step-by-step walkthroughs of a flow, driven by configuration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xenolithe-labs/feature-walkthrough.git"
  },
  "homepage": "https://xenolithe-labs.github.io/feature-walkthrough/",
  "keywords": [
    "walkthrough",
    "diagram",
    "sequence-diagram",
    "explainer",
    "react"
  ],
  "type": "module",
  "bin": {
    "feature-walkthrough": "dist/cli/index.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./style.css": "./dist/lib/style.css",
    "./schema.json": "./schema/walkthrough.schema.json",
    "./check-result.schema.json": "./schema/check-result.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "schema": "tsx scripts/export-schema.ts",
    "walkthrough": "tsx cli/index.ts",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:cli": "vite build -c vite.cli.config.ts",
    "build:all": "pnpm build && pnpm build:lib && pnpm build:cli",
    "prepack": "pnpm build:all",
    "skill": "tsx scripts/export-skill.ts",
    "colours": "tsx scripts/export-colours.ts"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "elkjs": "^0.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
