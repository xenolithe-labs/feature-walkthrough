{
  "name": "feature-walkthrough",
  "version": "0.0.0",
  "private": true,
  "description": "A configurable UI that shows step-by-step walkthroughs of a flow, driven by configuration.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "schema": "tsx scripts/export-schema.ts",
    "walkthrough": "tsx cli/index.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  }
}
